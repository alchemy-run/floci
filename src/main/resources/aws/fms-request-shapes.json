        "ManagedServiceData": "ManagedServiceData",
        "PolicyOption": "PolicyOption"
      }
    },
    "SecurityServiceType": {
      "type": "string",
      "enum": [
        "WAF",
        "WAFV2",
        "SHIELD_ADVANCED",
        "SECURITY_GROUPS_COMMON",
        "SECURITY_GROUPS_CONTENT_AUDIT",
        "SECURITY_GROUPS_USAGE_AUDIT",
        "NETWORK_FIREWALL",
        "DNS_FIREWALL",
        "THIRD_PARTY_FIREWALL",
        "IMPORT_NETWORK_FIREWALL",
        "NETWORK_ACL_COMMON"
      ]
    },
    "SecurityServiceTypeList": {
      "type": "list",
      "min": 0,
      "max": 32,
      "member": "SecurityServiceType"
    },
    "Tag": {
      "type": "structure",
      "required": [
        "Key",
        "Value"
      ],
      "members": {
        "Key": "TagKey",
        "Value": "TagValue"
      }
    },
    "TagKey": {
      "type": "string",
      "min": 1,
      "max": 128,
      "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
    },
    "TagKeyList": {
      "type": "list",
      "min": 0,
      "max": 200,
      "member": "TagKey"
    },
    "TagList": {
      "type": "list",
      "min": 0,
      "max": 200,
      "member": "Tag"
    },
    "TagResourceRequest": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "TagList"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "TagList": "TagList"
      }
    },
    "TagValue": {
      "type": "string",
      "min": 0,
      "max": 256,
      "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
    },
    "ThirdPartyFirewall": {
      "type": "string",
      "enum": [
        "PALO_ALTO_NETWORKS_CLOUD_NGFW",
        "FORTIGATE_CLOUD_NATIVE_FIREWALL"
      ]
    },
    "ThirdPartyFirewallPolicy": {
      "type": "structure",
      "members": {
        "FirewallDeploymentModel": "FirewallDeploymentModel"
      }
    },
    "TimeStamp": {
      "type": "timestamp"
    },
    "UntagResourceRequest": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "TagKeys"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "TagKeys": "TagKeyList"
      }
    },
    "UpdateToken": {
      "type": "string",
      "min": 1,
      "max": 1024,
      "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
    }
  }
}
